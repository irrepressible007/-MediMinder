<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and phone-to-phone transfer of the user's own data -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="mediminder.db" />
        <include domain="sharedpref" path="mediminder_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="mediminder.db" />
        <include domain="sharedpref" path="mediminder_settings.xml" />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
