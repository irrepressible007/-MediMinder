<?xml version="1.0" encoding="utf-8"?>
<!--
  MediMinder mark: an alarm clock whose hand is a capsule.
  Everything stays inside the 66dp safe zone of the 108dp adaptive-icon canvas.
  tools/render_launcher_icons.py draws the same shapes for the Android 7 PNG icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 88%: a little breathing room inside the launcher mask -->
    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.88" android:scaleY="0.88">

        <!-- alarm bells -->
        <group android:pivotX="54" android:pivotY="54" android:rotation="-42">
            <path android:fillColor="#FFFFFFFF" android:pathData="M47,29.5 A7,7 0 0 1 61,29.5 Z" />
        </group>
        <group android:pivotX="54" android:pivotY="54" android:rotation="42">
            <path android:fillColor="#FFFFFFFF" android:pathData="M47,29.5 A7,7 0 0 1 61,29.5 Z" />
        </group>

        <!-- clock face -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5"
            android:pathData="M54,32 A22,22 0 1 1 54,76 A22,22 0 1 1 54,32 Z" />

        <!-- capsule hand -->
        <group android:pivotX="54" android:pivotY="54" android:rotation="-45">
            <path android:fillColor="#FFFFFFFF" android:pathData="M54,48.5 L45.5,48.5 A5.5,5.5 0 0 0 45.5,59.5 L54,59.5 Z" />
            <path android:fillColor="#FFA7F3D0" android:pathData="M54,48.5 L62.5,48.5 A5.5,5.5 0 0 1 62.5,59.5 L54,59.5 Z" />
        </group>
    </group>
</vector>
